# Anthropic API key — get one at https://console.anthropic.com/settings/keys
# Copy this file to `.env` and fill in your key. `.env` is gitignored.
ANTHROPIC_API_KEY=sk-ant-...

# --- Model provider -------------------------------------------------
# Keep exactly ONE LLM_PROVIDER uncommented (restart the dev server after changing).
LLM_PROVIDER=anthropic
#LLM_PROVIDER=openrouter

# OpenRouter (used when LLM_PROVIDER=openrouter).
# Key: https://openrouter.ai/keys   Models: https://openrouter.ai/models
OPENROUTER_API_KEY=

# Pick ONE vision-capable model — comment/uncomment to switch.
# (Verify current slugs at https://openrouter.ai/models — availability changes.)
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct
#OPENROUTER_MODEL=minimax/minimax-m3
#OPENROUTER_MODEL=qwen/qwen3-vl-235b-a22b-instruct
#OPENROUTER_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# --- Research logging (optional) ------------------------------------
# Stores freestyle prompts + a random session id in Supabase for analysis.
# Leave blank to disable logging entirely (the app works fine without it).
# From your Supabase project: Settings → API → Project URL + service_role key.
# The service_role key is SERVER-ONLY — never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Bot protection: invisible proof-of-work (optional) -------------
# The browser solves a small SHA-256 puzzle in the background to earn a
# clearance cookie required by /api/chat. No third party, no cookies of its
# own, no user interaction. Leave blank to disable (the app still works,
# unprotected). Set to any long random string, e.g. `openssl rand -hex 32`.
# SERVER-ONLY — never expose it to the browser.
POW_SECRET=
# Difficulty: avg POW_MAX_NUMBER/2 hashes to solve. Higher = more deterrence
# but slower on old phones. Default 60000 (solves in the background quickly).
#POW_MAX_NUMBER=60000

# Max generations per session per hour (Supabase-backed). Default 40.
#GENERATION_HOURLY_CAP=40
