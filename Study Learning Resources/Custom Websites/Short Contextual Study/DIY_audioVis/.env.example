# Copy this file to .env and fill in the two values from your Supabase project.
# Project settings → API. Use the *anon / public* key ONLY. Never put the
# service_role key in this repo — the whole security model depends on the app
# only ever holding the public key (see PREFLIGHT.md step 6).

PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
